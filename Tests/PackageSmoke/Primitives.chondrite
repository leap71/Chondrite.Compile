schema Smoke.Int64Probe { 0: values int64[1] }
schema Smoke.UInt64Probe { 0: values uint64[1] }
schema Smoke.Float32Probe { 0: values float32[1] }
schema Smoke.Float64Probe { 0: values float64[1] }
schema Smoke.Utf8Probe { 0: values utf8[1] }
schema Smoke.BytesProbe { 0: values bytes[1] }
schema Smoke.Vector2fProbe { 0: values vector2f[1] }
schema Smoke.Vector3fProbe { 0: values vector3f[1] }
schema Smoke.Vector4fProbe { 0: values vector4f[1] }
schema Smoke.GuidProbe { 0: values guid[1] }
